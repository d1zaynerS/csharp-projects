@{
    var q = ViewBag.Question as WebApplication12.Models.Question;
    int qIndex = ViewBag.QuestionIndex;
    int score = ViewBag.Score;
}

<h2>Питання @(qIndex + 1) з @WebApplication12.Services.QuizService.Questions.Count</h2>
<p class="fs-4">@q.Text</p>

<form asp-controller="Quiz" asp-action="Answer" method="post">
    <input type="hidden" name="qIndex" value="@qIndex" />
    <input type="hidden" name="score" value="@score" />

    @for (int i = 0; i < q.Options.Count; i++)
    {
        <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="selectedOption" value="@i" id="opt_@i" required />
            <label class="form-check-label" for="opt_@i">
                @q.Options[i]
            </label>
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Наступне питання</button>
</form>