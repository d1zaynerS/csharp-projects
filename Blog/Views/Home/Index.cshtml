@model Blog.ViewModels.IndexViewModel<Blog.Models.Publication>

@{
    ViewData["Title"] = "Публікації";
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">Усі публікації</h1>

    <div class="row">
        @foreach (var item in Model.Items)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@item.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted">@item.SeoDescription</p>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary mt-auto">Читати далі</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center mt-4">
            @if (Model.PageViewModel.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber - 1)">Назад</a>
                </li>
            }
            @for (int i = 1; i <= Model.PageViewModel.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageViewModel.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
            @if (Model.PageViewModel.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber + 1)">Вперед</a>
                </li>
            }
        </ul>
    </nav>
</div>