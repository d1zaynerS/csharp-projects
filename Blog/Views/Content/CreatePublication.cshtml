@model Blog.ViewModels.PublicationViewModel

@{
    ViewBag.Title = "Додавання публікації";
}

<div class="container px-4 py-5" id="hanging-icons">
    <h2 class="pb-2 border-bottom">Додавання публікації</h2>
    <a asp-controller="Home" asp-action="Index">Головна</a> / <a asp-controller="Content" asp-action="Index">Управління матеріалом</a>
    <div class="row g-4 py-5 row-cols-1">
        <div class="p-5 mb-4 bg-light rounded-3">
            <form asp-controller="Content" asp-action="CreatePublication" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Title" class="control-label">Заголовок</label>
                    <input type="text" asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Content" class="control-label">Вміст</label>
                    <textarea asp-for="Content" class="form-control" rows="10"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="File" class="control-label">Зображення</label>
                    <input type="file" class="form-control" asp-for="File" accept="image/*" />
                </div>

                <hr class="featurette-divider">

                <div class="form-group">
                    <label class="control-label">Категорії</label>
                    <span class="input-icon">
                        <input type="text" placeholder="Пошук" id="colsearch2" class="form-control colsearch" onkeyup="sortCols2()">
                        <i class="fa fa-search"></i>
                    </span>
                    <div class="col-sm-12">Вибрані </div>
                    <ul id="col-active2" class="media-list overflow-auto ulr">
                        @if (Model.SelectListCategories != null)
                        {
                            @foreach (var category in Model.SelectListCategories.Where(e => e.Selected))
                            {
                                <li>
                                    <div class="checkbox sidebar-content list-group-item d-flex justify-content-between lh-condensed">
                                        <label>
                                            <input id="@category.Value" type="checkbox" name="SelectedCategories" value="@category.Value" checked="checked" class="green">
                                            @category.Text
                                        </label>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                    <div class="col-sm-12">Не вибрані </div>
                    <ul id="col-inactive2" class="media-list overflow-auto ulr">
                        @if (Model.SelectListCategories != null)
                        {
                            @foreach (var category in Model.SelectListCategories.Where(e => !e.Selected))
                            {
                                <li>
                                    <div class="checkbox sidebar-content list-group-item d-flex justify-content-between lh-condensed">
                                        <label>
                                            <input id="@category.Value" type="checkbox" name="SelectedCategories" value="@category.Value" class="green">
                                            @category.Text
                                        </label>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>

                <hr class="featurette-divider">

                <div class="form-group">
                    <label asp-for="SeoDescription" class="control-label">Seo опис</label>
                    <textarea asp-for="SeoDescription" class="form-control" rows="5"></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="Keywords" class="control-label">Ключові слова</label>
                    <input type="text" asp-for="Keywords" class="form-control" />
                </div>
                <br />
                <div class="form-group">
                    @Html.AntiForgeryToken()
                    <input type="submit" value="Додати" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/category.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}