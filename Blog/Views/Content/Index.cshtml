@using System.Text;
@model ContentViewModel
@{
    ViewBag.Title = "Матеріал";
}
<div class="container px-4 py-5" id="hanging-icons">
    <h2 class="pb-2 border-bottom">Управління матеріалом</h2>
    <a asp-controller="Home" asp-action="Index">Головна</a>
    <div class="row g-4 py-5 row-cols-1">
        <div>
            <a asp-controller="Content" asp-action="CreateCategory" class="btn btn-primary">Додати категорію</a>
            <a asp-controller="Content" asp-action="CreatePublication" class="btn btn-primary">Додати публікацію</a>
        </div>

        <h3>Категорії</h3>

        <div class="p-5 mb-4 bg-light rounded-3 ovx">
            <table class="table table-hover">
                <tr><th>Назва категорії</th><th></th><th></th></tr>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>
                            <a class="btn btn-sm btn-primary" asp-controller="Content" asp-action="EditCategory" asp-route-id="@category.Id">Змінити</a>
                        </td>
                        <td>
                            <form asp-controller="Content" asp-action="DeleteCategory" asp-route-id="@category.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>
        </div>

        <h3>Публікації</h3>

        <div class="p-5 mb-4 bg-light rounded-3 ovx">
            <table class="table table-hover">
                <tr><th>Назва записи</th><th>Категорії</th><th>Усього переглядів</th><th></th><th></th></tr>
                @foreach (var publication in Model.Publications)
                {
                    <tr>
                        <td>@publication.Title</td>
                        <td>
                            @{
                                StringBuilder st = new StringBuilder();
                                if (publication.Categories.Count > 0)
                                {
                                    foreach (Category category in publication.Categories)
                                    {
                                        st.Append($"{category.Name}, ");
                                    }
                                    st.Remove(st.Length - 2, 2);
                                }
                                else
                                {
                                    st.Append("Без категорії");
                                }
                            }
                            @st.ToString()
                        </td>
                        <td>@publication.TotalViews</td>
                        <td>
                            <a class="btn btn-sm btn-primary" asp-controller="Content" asp-action="EditPublication" asp-route-id="@publication.Id">Змінити</a>
                        </td>
                        <td>
                            <form asp-controller="Content" asp-action="DeletePublication" asp-route-id="@publication.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>
        </div>

    </div>
</div>