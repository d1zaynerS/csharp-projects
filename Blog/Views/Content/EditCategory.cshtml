@model CategoryViewModel
@{
    ViewBag.Title = "Редагування категорії";
}

<div class="container px-4 py-5" id="hanging-icons">
    <h2 class="pb-2 border-bottom">Редагування категорії</h2>
    <a asp-controller="Home" asp-action="Index">Головна</a> / <a asp-controller="Content" asp-action="Index">Управління матеріалом</a>
    <div class="row g-4 py-5 row-cols-1">
        <div class="p-5 mb-4 bg-light rounded-3">
            <form asp-controller="Content" asp-action="EditCategory" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <input type="hidden" asp-for="Id" />
                </div>
                <div class="form-group">
                    <label asp-for="Name" class="control-label">Назва</label>
                    <input type="text" asp-for="Name" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Description" class="control-label">Опис</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>
                <br />
                <div class="form-group">
                    @Html.AntiForgeryToken()
                    <input type="submit" value="Зберегти" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@*Для валідації моделі на клієнті*@
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}