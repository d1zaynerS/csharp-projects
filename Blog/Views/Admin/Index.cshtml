@model Blog.ViewModels.IndexViewModel<Blog.Models.User>

@{
    ViewData["Title"] = "Керування користувачами";
}

<div class="container mt-4">
    <h2>Користувачі</h2>

    <form method="get" asp-action="Index" class="row mb-3">
        <div class="col-md-8">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Пошук за ім'ям, email або логіном..." />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Пошук</button>
            <a asp-action="Index" class="btn btn-secondary">Скинути</a>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Email</th>
                <th>Ім'я</th>
                <th>Телефон</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Items)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.Name</td>
                    <td>@user.PhoneNumber</td>
                    <td>
                        <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Редагувати</a>
                        <a asp-action="EditRoles" asp-route-userId="@user.Id" class="btn btn-sm btn-info">Ролі</a>
                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Видалити користувача?')">Видалити</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (Model.PageViewModel.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber - 1)" asp-route-search="@ViewBag.Search">Назад</a>
                </li>
            }
            @for (int i = 1; i <= Model.PageViewModel.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageViewModel.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
            @if (Model.PageViewModel.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber + 1)" asp-route-search="@ViewBag.Search">Вперед</a>
                </li>
            }
        </ul>
    </nav>
</div>