@model ChangeRoleViewModel
@using Microsoft.AspNetCore.Identity

@{
    ViewBag.Title = "Зміна ролей користувача";
}

<div class="container px-4 py-5" id="hanging-icons">
    <h2 class="pb-2 border-bottom">Зміна ролей користувача</h2>
    <a asp-controller="Home" asp-action="Index">Головна</a> / <a asp-controller="Users" asp-action="Index">Все користувачі</a>
    <div class="row g-4 py-5 row-cols-1">
        <div class="p-5 mb-4 bg-light rounded-3">
            <form asp-controller="Admin" asp-action="EditRoles" method="post">
                <input type="hidden" name="userId" value="@Model.UserId" />
                <div class="form-group">
                    @foreach (IdentityRole role in Model.AllRoles)
                    {
                        <input type="checkbox" name="roles" value="@role.Name"
                        @(Model.UserRoles.Contains(role.Name) ? "checked=\"checked\"" : "") />
                        @role.Name
                        <br />
                    }
                </div>
                <div class="mt-3"></div>
                <div class="form-group">
                    @Html.AntiForgeryToken()
                    <input type="submit" value="Зберегти" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@*Для валідації моделі на клієнті*@
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}