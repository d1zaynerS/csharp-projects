@model List<Blog.Models.Subscriber>

@{
    ViewData["Title"] = "Керування підписниками";
}

<div class="container mt-4">
    <h2>Список передплатників</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="PrepareNewsletter" method="post">
        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Створити розсилку для обраних</button>
            <a asp-action="SendEmail" class="btn btn-outline-primary">Надіслати всім</a>
        </div>

        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th style="width: 40px;"><input type="checkbox" id="selectAll" /></th>
                    <th>Email</th>
                    <th>Дата підписки</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subscriber in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" name="selectedEmails" value="@subscriber.Email" class="sub-checkbox" />
                        </td>
                        <td>@subscriber.Email</td>
                        <td>@subscriber.SubscribedAt.ToString("g")</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@subscriber.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Видалити підписника?')">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>

<script>
    document.getElementById('selectAll')?.addEventListener('change', function() {
        var checkboxes = document.querySelectorAll('.sub-checkbox');
        for (var checkbox of checkboxes) {
            checkbox.checked = this.checked;
        }
    });
</script>