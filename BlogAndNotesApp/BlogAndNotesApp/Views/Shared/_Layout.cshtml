<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - BlogAndNotesApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            .dark-theme { background-color: #222; color: #fff; }
            .dark-theme .card { background-color: #333; color: #fff; border-color: #444; }
            .light-theme { background-color: #fff; color: #000; }
    </style>
</head>
<body class="@(Context.Request.Cookies["BlogTheme"] == "dark" ? "dark-theme" : "light-theme")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom mb-3">
            <div class="container">
                <a class="nav-link text-dark" asp-controller="Blog" asp-action="Index">Блог</a>
                <a class="nav-link text-dark" asp-controller="Blog" asp-action="Settings">Налаштування читання</a>
                <a class="nav-link text-dark" asp-controller="Notes" asp-action="Index">Нотатки</a>
                <a class="nav-link text-dark" asp-controller="Mapping" asp-action="Index">Демонстрація Мапінгу</a>
            </div>
        </nav>
    </header>
    <div class="container">
        @RenderBody()
    </div>
</body>
</html>