@model List<BlogAndNotesApp.Models.UserDestination>

<h2>Результати мапінгу (3 способи)</h2>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Спосіб мапінгу</th>
            <th>ID</th>
            <th>Ім'я</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.MappingType</strong></td>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Email</td>
            </tr>
        }
    </tbody>
</table>