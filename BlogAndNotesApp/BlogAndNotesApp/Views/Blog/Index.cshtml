@model List<BlogAndNotesApp.Models.News>

<h2>Особистий блог</h2>

<div class="row mt-3">
    @foreach (var item in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card p-3">
                <h3>@item.Title</h3>
                <small class="text-muted">@item.Date.ToShortDateString()</small>
                <p class="mt-2">@item.Content</p>
            </div>
        </div>
    }
</div>